# .env.example
# Copy this file to .env and fill in the values

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# GitHub Configuration for syncing articles.json
GITHUB_PAT=your_github_personal_access_token_here
GIST_ID=your_gist_id_here

# Secret key for Admin Dashboard Authentication
ADMIN_SECRET=your_super_secret_password

# Port for the Go server (Render sets this automatically, default is 8080 locally)
PORT=8080
